# Copy this file to .env.local and fill it in. Never commit real values.
#
#   Windows (cmd):   copy .env.example .env.local
#   macOS / Linux:   cp .env.example .env.local
#
# Comments live on their own line here, not after a value: everything after the
# "=" is taken literally, so a trailing "# like this" would become part of the secret.

# Required. Signs session cookies. Any 32+ random characters.
# Generate one (works on every platform, no openssl needed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Where the app is reached. Leave as-is for local development.
BETTER_AUTH_URL=http://localhost:3000

# The PostgreSQL connection string, from the Neon dashboard. Set this and the app
# uses Postgres; leave it unset and it uses a SQLite file, which is fine on your own
# machine and is refused on a deployed site. Keep ?sslmode=require on the end.
#   DATABASE_URL=postgresql://user:password@host.neon.tech/sagora?sslmode=require
# Paste it straight into .env.local. It is a password: never put it in a message,
# a screenshot, a commit or a chat.
# DATABASE_URL=

# Optional. Where the SQLite file lives when DATABASE_URL is unset.
# Defaults to ./data/sagora.db.
# DATABASE_PATH=

# Set to "production" on the live site only. It stops npm run db:reset from ever
# emptying that database, however the command is run.
# SAGORA_ENV=production

# Optional. Sends real email through Resend. Leave unset in development and every
# message is written to data/dev-outbox.jsonl instead, where you can read it.
# RESEND_API_KEY=
# EMAIL_FROM=Sagora <noreply@your-domain>

# Icons: Central Icon System (Iconists). Needed to INSTALL, not to run.
# `npm install` fails without it, so it must be set on every machine that builds
# the project — your laptop, CI, the deploy host. It can live here or in your
# system environment (Windows: setx CENTRAL_LICENSE_KEY "...").
# See https://iconists.co/central
CENTRAL_LICENSE_KEY=
