# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never, the template always
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/data

# test output
/e2e/.results
/e2e/screens
.neon

# throwaway measuring/debug scripts
/probe-*.mjs
/shot-*.mjs
/measure*.mjs

# Signing keys. These belong outside the repository entirely - this is only a safety net.
# A leaked upload key lets someone else publish an update as Sagora.
*.jks
*.keystore
keystore.properties
sagora-keys/

# android/ and ios/ are tracked on this branch - this is where the app is built from - so the
# rules main carries for them deliberately do not come across.
