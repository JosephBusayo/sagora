{
  "name": "sagora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --conditions react-server --env-file=.env.local scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "rm -f data/test.db data/dev-outbox.jsonl && DATABASE_PATH=data/test.db npm run db:migrate && playwright test"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "geist": "^1.8.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
