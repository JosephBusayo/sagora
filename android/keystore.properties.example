# Copy this to android/keystore.properties and fill it in. That file is gitignored and must
# stay that way: anyone holding the keystore and these passwords can publish an update as
# Sagora.
#
# The keystore itself belongs outside this repository - C:\Users\<you>\sagora-keys\ or
# wherever your important files live - and must be backed up somewhere off this machine.
#
# Windows paths: use forward slashes, or double the backslashes.

storeFile=C:/Users/USER/sagora-keys/sagora-upload.jks
storePassword=
keyAlias=sagora
keyPassword=
